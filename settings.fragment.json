{
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "supabase@claude-plugins-official": true,
    "vercel@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"__KIT__/hooks/careful.js\"" }
        ]
      },
      {
        "matcher": "mcp__.*[Ss]upabase.*__(execute_sql|apply_migration)",
        "hooks": [
          { "type": "command", "command": "node \"__KIT__/hooks/careful.js\"" }
        ]
      }
    ]
  }
}
